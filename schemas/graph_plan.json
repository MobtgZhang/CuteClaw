{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cuteclaw.dev/schemas/graph_plan.json",
  "title": "CuteClaw Graph Plan",
  "type": "object",
  "required": ["skill", "name", "nodes", "termination"],
  "properties": {
    "skill": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "input": { "type": ["object", "null"] },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://cuteclaw.dev/schemas/graph_node.json" }
    },
    "termination": {
      "type": "object",
      "required": ["kind", "limit", "direction", "max_iterations", "criterion"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "limit": { "type": "number" },
        "direction": { "type": "string", "enum": ["min", "max"] },
        "max_iterations": { "type": "integer", "minimum": 1 },
        "criterion": { "type": "string", "minLength": 1 }
      }
    }
  }
}
